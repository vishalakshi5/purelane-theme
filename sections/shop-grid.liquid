{{ 'section-shop-grid.css' | asset_url | stylesheet_tag }}

<section class="shop" id="shop">
  <div class="shop-head">
    <h2>{{ section.settings.heading }}</h2>
  </div>

<div class="shop-grid">
  {% for product in collections[section.settings.collection].products limit: 8 %}
    {% render 'product-card', product: product %}
  {% endfor %}
</div>
</section>

{% schema %}
{
  "name": "Shop Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display"
    }
  ],
  "presets": [
    {
      "name": "Shop Grid"
    }
  ]
}
{% endschema %}