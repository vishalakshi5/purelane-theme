{{ 'section-combos.css' | asset_url | stylesheet_tag }}

<section class="combos" id="combos">
  <div class="combos-head">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subheading }}</p>
  </div>

  <div class="combos-rail">
    {% for block in section.blocks %}
      <div class="combo-card" {{ block.shopify_attributes }}>
        {% if block.settings.flag != blank %}
          <span class="flag">{{ block.settings.flag }}</span>
        {% endif %}
        <h3>{{ block.settings.title }}</h3>
        <div class="count">{{ block.settings.count }}</div>
        <p class="inc">{{ block.settings.description }}</p>
        <div class="prow">
          <strong>{{ block.settings.price }}</strong>
          <s>{{ block.settings.compare_price }}</s>
        </div>
        <a class="btn btn-ghost" href="{{ block.settings.link }}">Shop bundle</a>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Combos",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Swipe through the boxes people order most." }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        { "type": "text", "id": "flag", "label": "Flag label (optional)", "placeholder": "e.g. Most popular" },
        { "type": "text", "id": "title", "label": "Title", "default": "Kitchen essentials" },
        { "type": "text", "id": "count", "label": "Product count", "default": "3 products" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "price", "label": "Price", "default": "₹499" },
        { "type": "text", "id": "compare_price", "label": "Compare-at price", "default": "₹897" },
        { "type": "url", "id": "link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Combos",
      "blocks": [
        { "type": "combo" },
        { "type": "combo" },
        { "type": "combo" }
      ]
    }
  ]
}
{% endschema %}