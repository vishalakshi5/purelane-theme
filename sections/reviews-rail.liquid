{{ 'section-reviews.css' | asset_url | stylesheet_tag }}

<section class="reviews" id="reviews">
  <div class="reviews-head">
    <h2>{{ section.settings.heading }}</h2>
  </div>

  <div class="reviews-rail">
    {% for block in section.blocks %}
      <div class="review-card" {{ block.shopify_attributes }}>
        <div class="stars">{{ block.settings.stars }}</div>
        <h5>{{ block.settings.title }}</h5>
        <p>{{ block.settings.text }}</p>
        <div class="who">
          <b>{{ block.settings.name }}</b>
          <span>{{ block.settings.product }}</span>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Reviews Rail",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "That's what they said"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
        { "type": "text", "id": "title", "label": "Title", "default": "Works like a charm" },
        { "type": "textarea", "id": "text", "label": "Review text" },
        { "type": "text", "id": "name", "label": "Customer name" },
        { "type": "text", "id": "product", "label": "Product name" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Rail",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}